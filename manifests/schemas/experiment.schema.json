{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/inkling-small-ampere/experiment.schema.json",
  "title": "Inkling-Small Ampere experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "created_at",
    "purpose",
    "project_commit",
    "source_model",
    "source_revision",
    "runtime",
    "runtime_revision",
    "environment_report_id",
    "quantization_profile",
    "parallelism",
    "max_model_len",
    "seed",
    "dataset_revision",
    "command"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "experiment"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{16}$",
      "description": "Derived from the canonical manifest without this field."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "project_commit": {
      "$ref": "#/$defs/gitSha"
    },
    "source_model": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "$ref": "#/$defs/gitSha"
    },
    "runtime": {
      "enum": ["vllm", "sglang", "fixture"]
    },
    "runtime_revision": {
      "$ref": "#/$defs/gitSha"
    },
    "transformers_revision": {
      "oneOf": [
        {"$ref": "#/$defs/gitSha"},
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      ]
    },
    "compressed_tensors_revision": {
      "oneOf": [
        {"$ref": "#/$defs/gitSha"},
        {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      ]
    },
    "environment_report_id": {
      "type": "string",
      "pattern": "^env-[a-f0-9]{16}$"
    },
    "quantization_profile": {
      "type": "string",
      "minLength": 1
    },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tensor_parallel_size",
        "expert_parallel_size",
        "pipeline_parallel_size"
      ],
      "properties": {
        "tensor_parallel_size": {"type": "integer", "minimum": 1},
        "expert_parallel_size": {"type": "integer", "minimum": 1},
        "pipeline_parallel_size": {"type": "integer", "minimum": 1}
      }
    },
    "max_model_len": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "dataset_revision": {
      "$ref": "#/$defs/gitSha"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}

