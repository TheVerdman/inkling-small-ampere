# Gate E Responses edge. The immutable Python base is intentionally separate
# from the multi-gigabyte vLLM serving image.
ARG PYTHON_IMAGE="python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c"
FROM ${PYTHON_IMAGE}

LABEL org.opencontainers.image.title="Inkling-Small Ampere Responses edge"
LABEL org.opencontainers.image.description="Authenticated OpenAI Responses to Vertex Invoke relay"
LABEL org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /opt/inkling/app

COPY src ./src
COPY configs/serving ./configs/serving

ENV PYTHONPATH=/opt/inkling/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    INKLING_SERVING_PROFILE=/opt/inkling/app/configs/serving/responses-2k-bringup-v1.json \
    INKLING_VERTEX_PLAN=/opt/inkling/app/configs/serving/vertex-gate-e-plan-v1.json

USER 65532:65532
EXPOSE 8080

ENTRYPOINT ["python", "-m", "inkling_ampere.serving.edge"]
CMD ["--profile", "/opt/inkling/app/configs/serving/responses-2k-bringup-v1.json", "--plan", "/opt/inkling/app/configs/serving/vertex-gate-e-plan-v1.json"]
