# Gate E prediction-mount diagnostic. Keep this image small so a bounded
# storage probe does not pull the multi-gigabyte vLLM serving image.
ARG PYTHON_IMAGE="python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c"
FROM ${PYTHON_IMAGE}

LABEL org.opencontainers.image.title="Inkling-Small Ampere storage probe"
LABEL org.opencontainers.image.description="No-checkpoint Vertex prediction mount diagnostic"
LABEL org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /opt/inkling/app

COPY src ./src
COPY configs/serving ./configs/serving

ENV PYTHONPATH=/opt/inkling/app/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    INKLING_VERTEX_PLAN=/opt/inkling/app/configs/serving/vertex-gate-e-plan-v1.json

# Run as the same effective root user as Dockerfile.serving so the diagnostic
# measures the production container's ability to create its restore directory.
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/python", "-m", "inkling_ampere.serving.storage_probe"]
CMD ["--plan", "/opt/inkling/app/configs/serving/vertex-gate-e-plan-v1.json"]
