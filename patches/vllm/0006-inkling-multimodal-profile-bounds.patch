+def test_inkling_dummy_inputs_honor_explicit_serving_bounds():
+    class FakeInfo:
+        def get_hf_config(self):
+            class VisionConfig:
+                patch_size = 40
+
+            class Config:
+                vision_config = VisionConfig()
+
+            return Config()
+
+        def get_hf_processor(self):
+            class Params:
+                audio_token_duration_s = 0.05
+                sample_rate = 16_000
+
+            class AudioFeatureExtractor:
+                params = Params()
+
+            class Processor:
+                audio_feature_extractor = AudioFeatureExtractor()
+
+            return Processor()
+
+    builder = InklingDummyInputsBuilder(FakeInfo())
+    data = builder.get_dummy_mm_data(
+        seq_len=2048,
+        mm_counts={"image": 1, "audio": 1},
+        mm_options={
+            "image": ImageDummyOptions(count=1, width=800, height=800),
+            "audio": AudioDummyOptions(count=1, length=480_000),
+        },
+    )
+
+    assert data["image"][0].size == (800, 800)
+    assert data["audio"][0].shape == (480_000,)
