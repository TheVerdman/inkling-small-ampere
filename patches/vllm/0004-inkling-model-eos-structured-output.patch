                 add_prefix_space=True,
             )
         else:
+            # Keep xgrammar's terminal tokens aligned with the model's
+            # generation stop tokens. Some model-aware tokenizers intentionally
+            # leave ``tokenizer.eos_token_id`` unset; xgrammar's spelling-based
+            # fallback can then select a different special token and terminate
+            # the grammar without terminating generation.
+            stop_token_ids = getattr(
+                self.vllm_config.model_config.hf_config, "eos_token_id", None
+            )
             tokenizer_info = xgr.TokenizerInfo.from_huggingface(
                 self.tokenizer,
                 vocab_size=self.vocab_size,
+                stop_token_ids=stop_token_ids,
             )
         self.compiler = xgr.GrammarCompiler(
             tokenizer_info,
