+def test_flex_score_mod_relative_bias():
+    rel_logits = torch.arange(2 * 3 * 4, dtype=torch.bfloat16).reshape(2, 3, 4)
+    score_mod = make_inkling_flex_score_mod(rel_logits, rel_extent=4)
+    score = torch.tensor(2.0)
+
+    in_range = score_mod(
+        score,
+        torch.tensor(0),
+        torch.tensor(1),
+        torch.tensor(7),
+        torch.tensor(5),
+        physical_q=torch.tensor(1),
+    )
+    expected_bias = rel_logits[1, 1, 2].float()
+    torch.testing.assert_close(in_range, score + expected_bias)
+
+    out_of_range = score_mod(
+        score,
+        torch.tensor(0),
+        torch.tensor(1),
+        torch.tensor(7),
+        torch.tensor(2),
+        physical_q=torch.tensor(1),
+    )
+    torch.testing.assert_close(out_of_range, score)
+
