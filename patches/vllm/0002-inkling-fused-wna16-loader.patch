+    @staticmethod
+    def _resolve_routed_param_name(experts: RoutedExperts, key: str) -> str:
+        """Map checkpoint names to pre-processing parameter names."""
+        if hasattr(experts, key):
+            return key
+        aliases = {
+            "w13_weight": "w13_weight_packed",
+            "w2_weight": "w2_weight_packed",
+            "w13_weight_scale_2": "w13_weight_global_scale",
+            "w2_weight_scale_2": "w2_weight_global_scale",
+        }
+        param_name = aliases.get(key, key)
+        if not hasattr(experts, param_name):
+            raise AttributeError(f"Routed experts have no parameter for {key!r}")
+        return param_name
+
+    @staticmethod
+    def _load_transposed_routed_param(
+        experts: RoutedExperts,
+        param: Parameter,
+        param_name: str,
+        weight: torch.Tensor,
+        slots: dict[int, int],
+    ) -> None:
+        """Load a fused Inkling tensor through vLLM's WNA16 shard loader."""
+        is_w13 = param_name.startswith("w13")
+        is_interleaved = param_name in {
+            "w13_weight_packed",
+            "w13_weight_scale",
+            "w13_weight_zero_point",
+        }
+        if is_w13 and is_interleaved:
+            shards = (("w1", weight[:, 0::2]), ("w3", weight[:, 1::2]))
+        elif is_w13:
+            shards = (("w1", weight),)
+        else:
+            shards = (("w2", weight),)
+
+        for gid in slots:
+            for shard_id, source in shards:
+                experts.weight_loader(
+                    param=param,
+                    loaded_weight=source[gid].contiguous().to(param.device),
+                    weight_name=param_name,
+                    shard_id=shard_id,
+                    expert_id=gid,
+                )
+
