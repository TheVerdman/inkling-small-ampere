+def test_moe_resolves_preprocessed_quantized_parameter_names() -> None:
+    experts = SimpleNamespace(
+        w13_weight_packed=torch.nn.Parameter(torch.empty(1)),
+        w2_weight_packed=torch.nn.Parameter(torch.empty(1)),
+        w13_weight_global_scale=torch.nn.Parameter(torch.empty(1)),
+        w2_weight_global_scale=torch.nn.Parameter(torch.empty(1)),
+    )
+
+    assert (
+        moe.InklingMoE._resolve_routed_param_name(experts, "w13_weight")
+        == "w13_weight_packed"
+    )
+    assert (
+        moe.InklingMoE._resolve_routed_param_name(experts, "w2_weight")
+        == "w2_weight_packed"
+    )
+    assert (
+        moe.InklingMoE._resolve_routed_param_name(experts, "w13_weight_scale_2")
+        == "w13_weight_global_scale"
+    )
+    assert (
+        moe.InklingMoE._resolve_routed_param_name(experts, "w2_weight_scale_2")
+        == "w2_weight_global_scale"
+    )
+
+
+def test_moe_deinterleaves_transposed_wna16_w13_load() -> None:
+    calls = []
+
+    def weight_loader(**kwargs) -> None:
+        calls.append(kwargs)
+
+    experts = SimpleNamespace(weight_loader=weight_loader)
+    param = torch.nn.Parameter(torch.empty(3, 2, 4))
+    param.is_transposed = True
+    weight = torch.arange(3 * 8 * 2).reshape(3, 8, 2)
+
+    moe.InklingMoE._load_transposed_routed_param(
+        experts,
+        param,
+        "w13_weight_packed",
+        weight,
+        {0: 0, 2: 1},
+    )
+
+    assert [(call["expert_id"], call["shard_id"]) for call in calls] == [
+        (0, "w1"),
+        (0, "w3"),
+        (2, "w1"),
+        (2, "w3"),
+    ]
+    torch.testing.assert_close(calls[0]["loaded_weight"], weight[0, 0::2])
+    torch.testing.assert_close(calls[1]["loaded_weight"], weight[0, 1::2])
+    torch.testing.assert_close(calls[2]["loaded_weight"], weight[2, 0::2])
+    torch.testing.assert_close(calls[3]["loaded_weight"], weight[2, 1::2])
+
+
